{
  "name": "chama-baileys-caller",
  "version": "1.2.4",
  "description": "WhatsApp Web VoIP Calling & Auto-Answer Engine powered by Baileys v7, WASM, and FFmpeg",
  "author": "Chama",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./dist/*": "./dist/*",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "dist/**/*",
    "WAProto/**/*",
    "assets/**/*",
    "engine-requirements.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.worker.json && tsc -p tsconfig.json",
    "preinstall": "node ./engine-requirements.js"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "voip",
    "call",
    "auto-answer",
    "webrtc",
    "audio-stream",
    "chama"
  ],
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "@roamhq/wrtc": "^0.10.0",
    "async-mutex": "^0.5.0",
    "libsignal": "^6.0.0",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.0.0",
    "pino": "^9.6.0",
    "protobufjs": "^7.5.6",
    "whatsapp-rust-bridge": "0.5.4",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "audio-decode": "^2.1.3",
    "jimp": "^1.6.1",
    "link-preview-js": "^3.0.0",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "audio-decode": { "optional": true },
    "jimp": { "optional": true },
    "link-preview-js": { "optional": true },
    "sharp": { "optional": true }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
